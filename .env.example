# ---------------------------------------------------------------
# BRYM — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores
# do seu projeto Supabase (Project Settings → API).
# ---------------------------------------------------------------

# URL do projeto Supabase, ex.: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública do cliente. Projetos novos do Supabase mostram uma
# "Publishable key" (sb_publishable_...). Projetos antigos mostram a
# "anon key" (JWT). Preencha UMA das duas — a aplicação aceita ambas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role do Supabase (Project Settings → API). SECRETA.
# Necessária em produção: o webhook do Stripe não tem sessão de usuário e
# escreve com ela. Único consumidor: app/api/stripe/webhook.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Asaas — gateway ATIVO (Pix nativo, mercado BR)
# ---------------------------------------------------------------

# sandbox | production — define a base URL da API
ASAAS_ENV=sandbox

# Chave de API do ambiente acima (Configurações → Integrações → API).
# Sandbox começa com $aact_hmlg_ , produção com $aact_prod_ . SECRETA.
# ATENÇÃO no .env.local: o Next expande "$" — escape os dois "$" da chave com
# "\$" (ex.: ASAAS_API_KEY=\$aact_hmlg_...::\$aach_...). Na Vercel, cole a chave
# crua no painel de env vars (lá não tem expansão).
ASAAS_API_KEY=

# Token que VOCÊ escolhe (32–255 chars, sem espaços) e cadastra no webhook do
# painel do Asaas. Todo evento chega com ele no header `asaas-access-token`.
ASAAS_WEBHOOK_TOKEN=

# ---------------------------------------------------------------
# Stripe — DORMENTE (reservado pra expansão europeia). Deixe vazio.
# ---------------------------------------------------------------

# Secret key (Developers → API keys). Comece com a de teste (sk_test_...).
STRIPE_SECRET_KEY=

# Signing secret do webhook (Developers → Webhooks → endpoint → Signing secret).
# Local: o valor que `stripe listen` imprime (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Payment Links fixos de cada plano (buy.stripe.com/...). Públicos.
NEXT_PUBLIC_STRIPE_LINK_ESSENCIAL=
NEXT_PUBLIC_STRIPE_LINK_PROFISSIONAL=
NEXT_PUBLIC_STRIPE_LINK_GESTAO=

# Price IDs recorrentes de cada plano (price_...). Não são segredo; o webhook
# usa pra saber qual plano foi assinado.
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_GESTAO=
